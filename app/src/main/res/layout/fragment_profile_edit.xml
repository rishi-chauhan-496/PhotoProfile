<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/RoundedTextField"
            app:startIconDrawable="@drawable/outline_account_circle_24"
            app:startIconTint="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/name"
                android:paddingStart="50dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textErrorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/layoutName"
            app:layout_constraintTop_toBottomOf="@id/layoutName" />

        <!-- Country -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCountry"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textErrorName"

            app:shapeAppearanceOverlay="@style/RoundedTextField"
            app:startIconDrawable="@drawable/outline_home_24"
            app:startIconTint="@color/black"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/editTextCountry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/country"
                android:inputType="none"
                android:paddingStart="50dp"/>

        </com.google.android.material.textfield.TextInputLayout>


        <TextView
            android:id="@+id/textErrorCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/layoutCountry"
            app:layout_constraintTop_toBottomOf="@id/layoutCountry" />

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textErrorCountry"
            app:shapeAppearanceOverlay="@style/RoundedTextField"
            app:startIconDrawable="@drawable/outline_stacked_email_24"
            app:startIconTint="@color/black"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:paddingStart="50dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textErrorEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/layoutEmail"
            app:layout_constraintTop_toBottomOf="@id/layoutEmail" />

        <!-- Everything below remains SAME -->

        <TextView
            android:id="@+id/textHobbiesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hobbies"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textErrorEmail" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxReading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/reading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textHobbiesLabel" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxCoding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/coding"
            app:layout_constraintBottom_toBottomOf="@+id/checkBoxReading"
            app:layout_constraintStart_toEndOf="@+id/checkBoxReading"
            app:layout_constraintTop_toTopOf="@+id/checkBoxReading" />


        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxGaming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/gaming"
            app:layout_constraintBottom_toBottomOf="@+id/checkBoxCoding"
            app:layout_constraintStart_toEndOf="@+id/checkBoxCoding"
            app:layout_constraintTop_toTopOf="@+id/checkBoxCoding" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxTraveling"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Traveling"
            app:layout_constraintBottom_toBottomOf="@+id/checkBoxCooking"
            app:layout_constraintStart_toEndOf="@+id/checkBoxCooking"
            app:layout_constraintTop_toTopOf="@+id/checkBoxCooking" />
        <!-- SECOND ROW (Brick shifted) -->

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxPhotography"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:checkable="true"
            android:text="Photography"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/checkBoxReading" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxCooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Cooking"
            app:layout_constraintBottom_toBottomOf="@+id/checkBoxPhotography"
            app:layout_constraintStart_toEndOf="@+id/checkBoxPhotography"
            app:layout_constraintTop_toTopOf="@+id/checkBoxPhotography" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxMusic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Music"
            app:layout_constraintBottom_toBottomOf="@+id/checkBoxGaming"
            app:layout_constraintStart_toEndOf="@+id/checkBoxGaming"
            app:layout_constraintTop_toTopOf="@+id/checkBoxGaming" />
        <!-- THIRD ROW -->

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxSports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Sports"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/checkBoxPhotography" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxFitness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Fitness"
            app:layout_constraintBottom_toBottomOf="@+id/checkBoxSports"
            app:layout_constraintStart_toEndOf="@+id/checkBoxSports"
            app:layout_constraintTop_toTopOf="@+id/checkBoxSports" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxMovies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Movies"
            app:layout_constraintBottom_toBottomOf="@+id/checkBoxFitness"
            app:layout_constraintStart_toEndOf="@+id/checkBoxFitness"
            app:layout_constraintTop_toTopOf="@+id/checkBoxFitness" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkBoxDrawing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Drawing"
            app:layout_constraintBottom_toBottomOf="@+id/checkBoxMovies"
            app:layout_constraintStart_toEndOf="@+id/checkBoxMovies"
            app:layout_constraintTop_toTopOf="@+id/checkBoxMovies" />

        <TextView
            android:id="@+id/textErrorHobbies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/checkBoxSports" />

        <TextView
            android:id="@+id/textImageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"
            android:text="@string/profile_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/checkBoxSports" />

        <ImageButton
            android:id="@+id/buttonPickImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/profile"
            android:scaleType="centerCrop"
            android:contentDescription="@string/pick_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textImageLabel" />

        <TextView
            android:id="@+id/textErrorImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonPickImage" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonInsert"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/save"
            app:cornerRadius="24dp"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonPickImage" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUpdate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/save"
            app:cornerRadius="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonPickImage"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
